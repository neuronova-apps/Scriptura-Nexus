---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../Card.astro';
import Callout from '../Callout.astro';
import Button from '../Button.astro';
import { basePath } from '../../lib/site';
import '../../styles/modules.css';
interface Props { label: string; description: string; phase: string; planned: string[]; empty: string; analyzerLink?: boolean; readerLink?: boolean; manuscriptLink?: boolean; }
const { label, description, phase, planned, empty, analyzerLink, readerLink, manuscriptLink } = Astro.props;
const home = basePath(import.meta.env.BASE_URL);
---
<BaseLayout title={label + ' | Scriptura Nexus'} description={description}>
  <div class="module-landing">
    <nav aria-label="Ruta de navegación"><ol class="module-breadcrumb"><li><a href={home}>Inicio</a></li><li aria-current="page">{label}</li></ol></nav>
    <Card variant="editorial">
      <p class="module-phase">Contenido en preparación · {phase}</p>
      <h1>{label}</h1>
      <p>{description}</p>
      <Callout tone="info" title="Módulo en desarrollo">{empty}</Callout>
    </Card>
    {analyzerLink && <section aria-labelledby="analyzer-link-title"><h2 id="analyzer-link-title">Analizador de términos bíblicos</h2><Card><p>Interfaz disponible en preparación. Los datos validados internamente aún no se han autorizado para consulta pública.</p><Button href={home + "linguistica/analizador/"} variant="secondary">Abrir analizador</Button></Card></section>}
    {analyzerLink && <section aria-labelledby="lexicon-link-title"><h2 id="lexicon-link-title">Léxicos y concordancias bíblicas</h2><Card><p>Consulta independiente de diccionarios, referencias y frecuencias. Interfaz preparada; datos públicos pendientes de autorización.</p><Button href={home + "linguistica/lexicos-concordancias/"} variant="secondary">Abrir léxicos y concordancias</Button></Card></section>}
    {readerLink && <section aria-labelledby="reader-link-title"><h2 id="reader-link-title">Lector bíblico</h2><Card><p>Interfaz preparada para consultar referencias por edición. Los textos todavía no están autorizados para consulta pública.</p><Button href={home + "biblia/lector/"} variant="secondary">Abrir lector bíblico</Button></Card></section>}
    {readerLink && <section aria-labelledby="comparator-link-title"><h2 id="comparator-link-title">Comparador bíblico</h2><Card><p>Lecturas paralelas y correspondencias documentadas entre ediciones. Los textos todavía no están autorizados para consulta pública.</p><Button href={home + "biblia/comparador/"} variant="secondary">Abrir comparador bíblico</Button></Card></section>}
    {manuscriptLink && <section aria-labelledby="manuscript-link-title"><h2 id="manuscript-link-title">Catálogo de manuscritos y variantes</h2><Card><p>Fichas, testimonios y referencias documentales. Los registros aún requieren autorización para consulta pública.</p><Button href={home + "manuscritos/consulta/"} variant="secondary">Abrir catálogo de manuscritos</Button></Card></section>}
    <section aria-labelledby="planned-title">
      <h2 id="planned-title">Recursos previstos</h2>
      <Card><ul class="module-planned">{planned.map(item => <li>{item}</li>)}</ul></Card>
    </section>
    <Button href={home} variant="secondary">Volver al inicio</Button>
  </div>
</BaseLayout>
