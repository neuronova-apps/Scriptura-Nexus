---
interface Props {
  tone?: 'info' | 'success' | 'warning';
  title?: string;
  class?: string;
}
const { tone = 'info', title, class: className } = Astro.props;
---
<aside class:list={['sn-callout', `sn-callout--${tone}`, className]} role="note">
  <span class="sn-callout__content">
    {title && <span class="sn-callout__title">{title}</span>}
    <slot />
  </span>
</aside>
