---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', type = 'button', disabled = false, class: className } = Astro.props;
const classes = ['sn-button', `sn-button--${variant}`, `sn-button--${size}`, className];
---
{href && !disabled ? (
  <a class:list={classes} href={href}><slot /></a>
) : (
  <button class:list={classes} type={type} disabled={disabled}><slot /></button>
)}
