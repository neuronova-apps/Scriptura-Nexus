---
interface Props {
  title: string;
  level?: 1 | 2;
  eyebrow?: string;
  description?: string;
  id?: string;
}
const { title, eyebrow, description, id, level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---
<header class="sn-section-heading">
  {eyebrow && <p class="sn-section-heading__eyebrow">{eyebrow}</p>}
  <Heading id={id}>{title}</Heading>
  {description && <p class="sn-section-heading__description">{description}</p>}
</header>
