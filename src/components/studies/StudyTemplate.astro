---
import type { Snapshot } from '../../lib/publication';
import { plannedTemplate, sectionView } from '../../lib/study-template';
import '../../styles/study-template.css';
interface Props { studyId:string; snapshot?:Snapshot; reviewOnly?:boolean }
const {studyId,snapshot,reviewOnly=false}=Astro.props;
const sections=snapshot?snapshot.record.sections.map(s=>sectionView(s,ref=>snapshot.bodies[ref])):plannedTemplate(studyId);
---
<section class="study-template" aria-labelledby="plantilla-titulo">
  <h2 id="plantilla-titulo">Estructura de la investigación</h2>
  <p>{reviewOnly?'Candidato de revisión no publicado.':snapshot?'Versión editorial aprobada. Las omisiones se explican en cada sección.':'Plantilla metodológica de 20 secciones. Todas están pendientes de desarrollo editorial. Las orientaciones describen el trabajo previsto, no resultados de investigación.'}</p>
  <nav class="study-template-nav sn-card sn-card--outlined" id="indice-secciones" aria-label="Índice de secciones de investigación">
    <h3>Índice de secciones</h3>
    <ol>{sections.map(s=><li><a href={'#'+s.anchor}>{s.title}</a></li>)}</ol>
  </nav>
  <div class="study-template-sections">
    {sections.map(s=><section id={s.anchor} data-section-id={s.id} data-section-state={s.state} aria-labelledby={s.anchor+'-titulo'} class="sn-card sn-card--default study-template-section">
      <h3 id={s.anchor+'-titulo'}>{String(s.order).padStart(2,'0')}. {s.title}</h3>
      <p class="study-section-state">Estado: <strong>{s.label}</strong></p>
      <p>{snapshot && !reviewOnly && s.state==='revisada' ? 'Contenido revisado de la versión aprobada.' : s.explanation}</p>{s.body && <p class="study-approved-body">{s.body}</p>}
      <details><summary>Orientación metodológica</summary><p>{s.procedure}</p><p><strong>Entregable previsto:</strong> {s.deliverable}</p></details>
      <a class="study-back-index" href="#indice-secciones">Volver al índice de secciones</a>
    </section>)}
  </div>
</section>
