---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import {bibliographyRegistry} from '../../lib/bibliography';
import {documentaryEntries,documentTypes,languageLabels,documentSearchText} from '../../lib/bibliography-exploration';
import {traditions} from '../../lib/taxonomy';
import {basePath} from '../../lib/site';
import '../../styles/modules.css';
import '../../styles/library.css';
const base=basePath(import.meta.env.BASE_URL);
const entries=documentaryEntries(bibliographyRegistry());
const names=new Map(traditions.map(t=>[t.id,t.name]));
const languages=[...new Set(entries.map(e=>e.edition.language))].sort();
---
<BaseLayout title="Biblioteca teológica | Scriptura Nexus" description="Catálogo de referencias documentales, autores y fuentes externas.">
<div class="module-landing">
<nav aria-label="Ruta de navegación"><ol class="module-breadcrumb"><li><a href={base}>Inicio</a></li><li aria-current="page">Biblioteca teológica</li></ol></nav>
<Card variant="editorial"><p class="module-phase">Biblioteca documental · P7.3</p><h1>Biblioteca teológica</h1><p>Consulta {entries.length} ediciones documentales iniciales. La inclusión de una referencia no significa adhesión a su doctrina ni autorización para reproducir su contenido.</p><p>Catálogo inicial ampliable; la representación de tradiciones no es exhaustiva.</p></Card>
<nav aria-label="Recursos documentales relacionados" class="library-links"><a href={base+'historia/'}>Historia cristiana</a><a href={base+'fundamentos/glosario/'}>Glosario metodológico</a><a href={base+'fundamentos/fuentes/'}>Fuentes y evidencias</a><a href={base+'biblioteca/permisos/'}>Registro de licencias y permisos</a><a href={base+'fundamentos/licencias/'}>Guía de licencias y atribuciones</a></nav>
<section aria-labelledby="documentos-titulo"><h2 id="documentos-titulo">Catálogo documental</h2>
<div class="library-filters" data-library-filters hidden>
<label for="library-query">Buscar por título, autor, ID, DOI o tema documental<input id="library-query" type="search" autocomplete="off" /></label>
<label for="library-tradition">Tradición o marco<select id="library-tradition"><option value="">Todos</option>{traditions.map(t=><option value={t.id}>{t.name}</option>)}<option value="sin_atribucion">Sin atribución confesional moderna</option></select></label>
<label for="library-type">Tipo documental<select id="library-type"><option value="">Todos</option>{Object.entries(documentTypes).map(([id,label])=><option value={id}>{label}</option>)}</select></label>
<label for="library-language">Idioma de la edición<select id="library-language"><option value="">Todos</option>{languages.map(l=><option value={l}>{languageLabels[l]??l}</option>)}</select></label>
<button type="button" id="library-reset" class="sn-button sn-button--secondary">Restablecer filtros</button></div>
<noscript><p>Las fichas y enlaces están disponibles sin JavaScript. La búsqueda y los filtros requieren JavaScript.</p></noscript>
<p id="library-count" role="status" aria-live="polite">{entries.length} documentos</p><p id="library-empty" hidden>No hay documentos que coincidan con los filtros. El catálogo es inicial y puede no incluir todavía una tradición o tipo documental.</p>
<div class="library-grid">{entries.map(e=><article class="sn-card sn-card--default library-document" data-document-id={e.edition.id} data-traditions={e.traditionIds.join(' ')} data-kind={e.work.kind} data-language={e.edition.language} data-search={documentSearchText([e.edition.id,e.work.id,e.work.title,e.work.authority,e.work.dateLabel??'',e.edition.edition,e.edition.publisher,e.edition.doi??'',e.edition.isbn??'',e.edition.provenance.locator,...e.authors.map(a=>a.name),...e.traditionIds.map(t=>names.get(t)??t),documentTypes[e.work.kind],languageLabels[e.edition.language]??e.edition.language])}>
<p class="module-phase">{e.edition.id} · {documentTypes[e.work.kind]}</p><h3><a href={base+'biblioteca/documentos/'+e.edition.id+'/'}>{e.work.title}</a></h3>
<p>{e.authors.map(a=>a.name).join('; ')}</p><p>{e.traditionIds.length?e.traditionIds.map(t=>names.get(t)??t).join('; '):'Sin atribución confesional moderna'}</p><p>Edición: {languageLabels[e.edition.language]??e.edition.language} · {e.edition.yearLabel}</p><p>{e.work.authority}</p><p>Consulta externa · Permisos pendientes de revisión</p></article>)}</div></section>
<section aria-labelledby="autores-titulo"><h2 id="autores-titulo">Autores e instituciones</h2><ul>{[...new Map(entries.flatMap(e=>e.authors).map(a=>[a.id,a])).values()].map(a=><li><a href={base+'biblioteca/autores/'+a.id+'/'}>{a.name}</a></li>)}</ul></section>
</div></BaseLayout>
<script>
import {matchesDocumentFilter} from '../../lib/bibliography-exploration';
const q=document.querySelector<HTMLInputElement>('#library-query');
const t=document.querySelector<HTMLSelectElement>('#library-tradition');
const k=document.querySelector<HTMLSelectElement>('#library-type');
const l=document.querySelector<HTMLSelectElement>('#library-language');
const panel=document.querySelector<HTMLElement>('[data-library-filters]');
const count=document.querySelector<HTMLElement>('#library-count');
const empty=document.querySelector<HTMLElement>('#library-empty');
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-document-id]'));
if(q&&t&&k&&l&&panel&&count&&empty){
 const apply=()=>{let n=0;for(const card of cards){card.hidden=!matchesDocumentFilter(card.dataset.search??'',(card.dataset.traditions??'').split(' ').filter(Boolean),card.dataset.kind??'',card.dataset.language??'',q.value,t.value,k.value,l.value);if(!card.hidden)n++;}count.textContent=n+(n===1?' documento':' documentos');empty.hidden=n!==0;};
 q.addEventListener('input',apply);for(const field of [t,k,l])field.addEventListener('change',apply);
 document.querySelector('#library-reset')?.addEventListener('click',()=>{q.value=t.value=k.value=l.value='';apply();q.focus();});
 panel.hidden=false;apply();
}
</script>
