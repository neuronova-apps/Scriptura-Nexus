---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import StudyList from '../../components/catalog/StudyList.astro';
import { axes } from '../../lib/taxonomy';
import { studies, studiesByAxis } from '../../lib/catalog';
import { statusLabels } from '../../lib/catalog-exploration';
import { basePath } from '../../lib/site';
import '../../styles/modules.css';
import '../../styles/catalog.css';
const base = basePath(import.meta.env.BASE_URL);
---
<BaseLayout title="Estudios bíblicos y relacionados | Scriptura Nexus" description="Exploración de ejes y catálogo de investigaciones planificadas.">
<div class="module-landing">
<nav aria-label="Ruta de navegación"><ol class="module-breadcrumb"><li><a href={base}>Inicio</a></li><li aria-current="page">Estudios bíblicos</li></ol></nav>
<Card variant="editorial"><p class="module-phase">Catálogo de investigaciones · P10.1</p><h1>Estudios bíblicos</h1><p>{axes.length} ejes temáticos y {studies.length} investigaciones planificadas. Las fichas contienen información preliminar; no son estudios publicados ni conclusiones aprobadas.</p></Card>
<section aria-labelledby="ejes-titulo"><h2 id="ejes-titulo">Ejes temáticos</h2><div class="catalog-grid">
{axes.map(axis => <Card><p class="module-phase">{axis.id}</p><h3><a href={base + 'ejes/' + axis.id + '/'}>{axis.name}</a></h3><p>{axis.scope}</p><p>{studiesByAxis(axis.id).length} investigaciones principales</p>{!studiesByAxis(axis.id).length && <p>Sin investigaciones principales por ahora. Consulta sus relaciones transversales.</p>}</Card>)}
</div></section>
<section aria-labelledby="catalogo-titulo" id="catalogo"><h2 id="catalogo-titulo">Catálogo de investigaciones</h2>
<p><a class="sn-button sn-button--secondary" href={base+'buscar/'}>Buscar investigaciones</a></p>
<div class="catalog-filters" data-catalog-filters hidden>
<label for="catalog-axis">Eje principal<select id="catalog-axis"><option value="">Todos los ejes</option>{axes.map(axis => <option value={axis.id}>{axis.id} · {axis.name}</option>)}</select></label>
<label for="catalog-status">Estado editorial<select id="catalog-status"><option value="">Todos los estados</option>{Object.entries(statusLabels).map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
<button type="button" class="sn-button sn-button--secondary" id="catalog-reset">Restablecer filtros</button>
</div>
<noscript><p>El catálogo completo y las fichas de ejes se pueden consultar sin JavaScript. Los filtros interactivos requieren JavaScript.</p></noscript>
<p id="catalog-count" role="status" aria-live="polite">{studies.length} investigaciones</p>
<p class="catalog-empty" id="catalog-empty" hidden>No hay investigaciones que coincidan con los filtros. Consulta las fichas de ejes para las relaciones transversales o restablece los filtros.</p>
<StudyList items={studies} />
</section>
</div>
</BaseLayout>
<script>
import { matchesCatalogFilter } from '../../lib/catalog-exploration';
const axis = document.querySelector<HTMLSelectElement>('#catalog-axis');
const status = document.querySelector<HTMLSelectElement>('#catalog-status');
const panel = document.querySelector<HTMLElement>('[data-catalog-filters]');
const count = document.querySelector<HTMLElement>('#catalog-count');
const empty = document.querySelector<HTMLElement>('#catalog-empty');
const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-study-id]'));
if (axis && status && panel && count && empty) {
  const apply = () => {
    let visible = 0;
    for (const card of cards) {
      card.hidden = !matchesCatalogFilter(card.dataset.axis ?? '', card.dataset.status ?? '', axis.value, status.value);
      if (!card.hidden) visible++;
    }
    count.textContent = visible + (visible === 1 ? ' investigación' : ' investigaciones');
    empty.hidden = visible !== 0;
  };
  axis.addEventListener('change', apply);
  status.addEventListener('change', apply);
  document.querySelector('#catalog-reset')?.addEventListener('click', () => { axis.value = ''; status.value = ''; apply(); });
  panel.hidden = false;
  apply();
}
</script>
