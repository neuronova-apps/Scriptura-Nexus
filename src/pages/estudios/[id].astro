---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import StudyTemplate from '../../components/studies/StudyTemplate.astro';
import StudyRelations from '../../components/studies/StudyRelations.astro';
import Callout from '../../components/Callout.astro';
import { studies } from '../../lib/catalog';
import { getAxis, traditions } from '../../lib/taxonomy';
import { getApprovedSnapshot } from '../../lib/publication-registry';
import EditorialRelations from '../../components/studies/EditorialRelations.astro';
import { statusLabels } from '../../lib/catalog-exploration';
import { basePath } from '../../lib/site';
import '../../styles/modules.css';
export function getStaticPaths() { return studies.map(study => ({params:{id:study.id},props:{study}})); }
const { study } = Astro.props;
const base = basePath(import.meta.env.BASE_URL);
const snapshot=getApprovedSnapshot(study.id);
const studyTitles=Object.fromEntries(studies.map(s=>[s.id,s.title]));
const traditionNames=Object.fromEntries(traditions.map(t=>[t.id,t.name]));
---
<BaseLayout title={study.title + ' | Scriptura Nexus'} description={study.question}>
<div class="module-landing">
<nav aria-label="Ruta de navegación"><ol class="module-breadcrumb"><li><a href={base}>Inicio</a></li><li><a href={base + 'estudios/'}>Estudios bíblicos</a></li><li><a href={base + 'ejes/' + study.primaryAxisId + '/'}>{study.primaryAxisId}</a></li><li aria-current="page">{study.id}</li></ol></nav>
<Card variant="editorial"><p class="module-phase">{study.id} · {statusLabels[study.status]} · Versión {study.version}</p><h1>{study.title}</h1><Callout tone="info" title="Ficha preliminar del catálogo">Investigación planificada. No se ha publicado un estudio ni se han aprobado conclusiones. Las referencias iniciales orientan la investigación, no constituyen evidencia verificada.</Callout></Card>
<Card><h2>Pregunta o foco de investigación</h2><p>{study.question}</p><h2>Eje principal</h2><p><a href={base + 'ejes/' + study.primaryAxisId + '/'}>{study.primaryAxisId} · {getAxis(study.primaryAxisId)?.name}</a></p><h2>Ejes relacionados</h2>{study.relatedAxisIds.length ? <ul>{study.relatedAxisIds.map(id => <li><a href={base + 'ejes/' + id + '/'}>{id} · {getAxis(id)?.name}</a></li>)}</ul> : <p>No hay ejes relacionados registrados.</p>}</Card>
<Card><h2>Referencias preliminares</h2>{study.initialReferences.length ? <ul>{study.initialReferences.map(reference => <li>{reference}</li>)}</ul> : <p>{study.referenceSelectionPending}</p>}<h2>Registro editorial</h2><p>Estado: {statusLabels[study.status]}. Versión: {study.version}.</p><p>Registro: {study.createdAt}. Actualización: {study.updatedAt}.</p><p>Disciplinas específicas, métodos, tradiciones y evidencias pendientes de selección durante la investigación.</p><p>Procedencia: {study.sourceRefs.join(', ')}.</p></Card>
<section aria-labelledby="publicacion-titulo" class="sn-card sn-card--outlined"><h2 id="publicacion-titulo">Publicación editorial</h2>{snapshot ? <p>Versión aprobada: {snapshot.version} · {snapshot.publishedAt}.</p> : <p>Sin versión aprobada. Esta ficha permanece planificada.</p>}</section>
<StudyTemplate studyId={study.id} snapshot={snapshot}/>
{snapshot && <EditorialRelations record={snapshot.record} relations={snapshot.relations} studyTitles={studyTitles} traditionNames={traditionNames}/>}
<StudyRelations study={study} catalog={studies}/>
<p><a href={base + 'fundamentos/'}>Consultar metodología de investigación</a></p>
<a class="sn-button sn-button--secondary" href={base + 'estudios/'}>Volver al catálogo</a>
</div></BaseLayout>
