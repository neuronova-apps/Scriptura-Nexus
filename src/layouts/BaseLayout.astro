---
import '../styles/brand.css';
import SiteNavigation from '../components/navigation/SiteNavigation.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import { basePath } from '../lib/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = basePath(import.meta.env.BASE_URL);
---
<!doctype html>
<html lang="es" data-theme="light" data-font-scale="100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#142b3c" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <title>{title}</title>
  <script is:inline>
    (() => {
      try {
        const stored = window.localStorage.getItem('scriptura-nexus:appearance:v1');
        if (!stored) return;
        const preferences = JSON.parse(stored);
        const themes = ['light', 'dark', 'contrast-light', 'contrast-dark'];
        const scales = ['100', '115', '130'];
        document.documentElement.dataset.theme = themes.includes(preferences.theme) ? preferences.theme : 'light';
        document.documentElement.dataset.fontScale = scales.includes(String(preferences.fontScale)) ? String(preferences.fontScale) : '100';
      } catch {
        // La página conserva la apariencia clara predeterminada si el almacenamiento no está disponible.
      }
    })();
  </script>
</head>
<body>
  <a class="skip" href="#contenido">Ir al contenido</a>
  <div class="site-frame">
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand-lockup" href={base} aria-label="Scriptura Nexus, inicio">
          <img class="brand-mark" src={`${base}brand/scriptura-mark.svg`} alt="" width="60" height="60" />
          <span>
            <span class="brand-name">Scriptura Nexus</span>
            <span class="brand-descriptor">Estudio bíblico histórico, exegético y teológico comparado</span>
          </span>
        </a>
        <details class="appearance-settings" data-appearance-panel hidden>
          <summary>Apariencia</summary>
          <div class="appearance-settings__panel">
            <p class="appearance-settings__title">Preferencias visuales</p>
            <label class="appearance-settings__field" for="sn-appearance-theme">
              <span>Modo de visualización</span>
              <select id="sn-appearance-theme" data-appearance-theme>
                <option value="light">Claro</option>
                <option value="dark">Oscuro</option>
                <option value="contrast-light">Alto contraste claro</option>
                <option value="contrast-dark">Alto contraste oscuro</option>
              </select>
            </label>
            <label class="appearance-settings__field" for="sn-appearance-font-scale">
              <span>Tamaño de letra</span>
              <select id="sn-appearance-font-scale" data-appearance-font-scale>
                <option value="100">Estándar (100 %)</option>
                <option value="115">Grande (115 %)</option>
                <option value="130">Muy grande (130 %)</option>
              </select>
            </label>
            <button class="sn-button sn-button--secondary appearance-settings__reset" type="button" data-appearance-reset>Restablecer preferencias</button>
            <p class="appearance-settings__status" data-appearance-status role="status" aria-live="polite">Las preferencias se guardan únicamente en este navegador.</p>
          </div>
        </details>
        <noscript><p>Para cambiar la apariencia, habilita JavaScript en tu navegador.</p></noscript>
      </div>
      <SiteNavigation base={base} pathname={Astro.url.pathname} />
    </header>
    <main id="contenido" class="site-main" tabindex="-1"><div class="site-main-inner"><slot /></div></main>
    <SiteFooter base={base} />
  </div>
  <script>
    import '../scripts/appearance';
  </script>
</body>
</html>
