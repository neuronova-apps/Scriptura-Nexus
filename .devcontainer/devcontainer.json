{
  "name": "Scriptura Nexus - Node 24 y Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "npm ci",
  "forwardPorts": [
    4321
  ],
  "portsAttributes": {
    "4321": {
      "label": "Scriptura Nexus - vista previa",
      "onAutoForward": "notify"
    },
    "43173": {
      "label": "Scriptura Nexus - revisión privada",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "vscode"
}
